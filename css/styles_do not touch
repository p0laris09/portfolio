/* =====================================================
   ANNE LORRAINE RAMOS - PORTFOLIO
   Clean, Modern Design
   ===================================================== */

/* CSS Variables */
:root {
  --primary: #10B981;
  --primary-dark: #059669;
  --primary-light: #34D399;
  --bg-dark: #0F172A;
  --bg-dark-secondary: #1E293B;
  --bg-light: #F8FAFC;
  --bg-light-secondary: #F1F5F9;
  --text-dark: #0F172A;
  --text-light: #F8FAFC;
  --text-muted: #64748B;
  --text-muted-light: #94A3B8;
}

/* Reset */
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  background: var(--bg-light);
  color: var(--text-dark);
  line-height: 1.6;
  overflow-x: hidden;
}

a { text-decoration: none; color: inherit; transition: 0.3s ease; }
img { max-width: 100%; height: auto; display: block; }

/* Utility */
.text-gradient {
  background: linear-gradient(135deg, var(--primary) 0%, #3B82F6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* =====================================================
   NAVBAR
   ===================================================== */
.navbar {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  padding: 1rem 0;
  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.05);
  transition: 0.3s ease;
}

.navbar.scrolled {
  padding: 0.75rem 0;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
}

.navbar-brand .brand-text {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--text-dark);
}

.brand-accent { color: var(--primary); }

.navbar-nav .nav-link {
  color: var(--text-muted);
  font-weight: 500;
  padding: 0.5rem 1rem;
  position: relative;
}

.navbar-nav .nav-link:hover,
.navbar-nav .nav-link.active {
  color: var(--primary);
}

.btn-primary-custom {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white !important;
  padding: 0.625rem 1.5rem;
  border-radius: 50px;
  font-weight: 600;
  border: none;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  transition: 0.3s ease;
}

.btn-primary-custom:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);
  color: white !important;
}

.btn-outline-custom {
  background: transparent;
  color: var(--text-light);
  padding: 0.625rem 1.5rem;
  border-radius: 50px;
  font-weight: 600;
  border: 2px solid rgba(255, 255, 255, 0.3);
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  transition: 0.3s ease;
}

.btn-outline-custom:hover {
  border-color: var(--primary);
  color: var(--primary);
}

/* =====================================================
   HERO SECTION
   ===================================================== */
.hero-section {
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 50%, #0F172A 100%);
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding-top: 80px;
}

/* Animated Background */
.hero-bg-shapes {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.shape {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.5;
}

.shape-1 {
  width: 600px;
  height: 600px;
  background: rgba(16, 185, 129, 0.3);
  top: -200px;
  right: -200px;
  animation: float 20s ease-in-out infinite;
}

.shape-2 {
  width: 400px;
  height: 400px;
  background: rgba(59, 130, 246, 0.25);
  bottom: -100px;
  left: -100px;
  animation: float 15s ease-in-out infinite reverse;
}

.shape-3 {
  width: 300px;
  height: 300px;
  background: rgba(139, 92, 246, 0.2);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation: pulse 10s ease-in-out infinite;
}

.shape-4 {
  width: 500px;
  height: 500px;
  background: rgba(236, 72, 153, 0.15);
  top: 30%;
  right: 20%;
  animation: float 18s ease-in-out infinite;
}

.grid-overlay {
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 50px 50px;
  mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
}

@keyframes float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-30px) rotate(5deg); }
}

@keyframes pulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
  50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.7; }
}

/* Hero Content */
.hero-content { position: relative; z-index: 2; }

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: 50px;
  color: var(--primary-light);
  font-size: 0.875rem;
  font-weight: 500;
  margin-bottom: 1.5rem;
}

.badge-dot {
  width: 8px;
  height: 8px;
  background: var(--primary);
  border-radius: 50%;
  animation: blink 2s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.hero-title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 800;
  color: var(--text-light);
  line-height: 1.1;
  margin-bottom: 0.5rem;
}

.hero-subtitle {
  font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  font-weight: 600;
  color: var(--text-muted-light);
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.typing-text {
  background: linear-gradient(135deg, var(--primary) 0%, #3B82F6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.typing-cursor {
  color: var(--primary);
  animation: cursor-blink 1s step-end infinite;
}

@keyframes cursor-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.hero-description {
  font-size: 1.125rem;
  color: var(--text-muted-light);
  max-width: 500px;
  margin-bottom: 2rem;
  line-height: 1.7;
}

.hero-cta {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 2rem;
}

.hero-social {
  display: flex;
  gap: 0.75rem;
}

.social-link {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: var(--text-light);
  font-size: 1.125rem;
  transition: 0.3s ease;
}

.social-link:hover {
  background: var(--primary);
  color: white;
  transform: translateY(-3px);
}

/* Hero Image */
.hero-image-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 500px;
}

.hero-image-container { position: relative; }

.image-glow {
  position: absolute;
  width: 350px;
  height: 350px;
  background: linear-gradient(135deg, var(--primary) 0%, #3B82F6 100%);
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.3;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.hero-blob {
  position: absolute;
  width: 400px;
  height: 400px;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(59, 130, 246, 0.2) 50%, rgba(139, 92, 246, 0.2) 100%);
  border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation: blob-morph 8s ease-in-out infinite;
  filter: blur(40px);
}

@keyframes blob-morph {
  0%, 100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
  25% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }
  50% { border-radius: 50% 60% 30% 60% / 30% 60% 70% 40%; }
  75% { border-radius: 60% 40% 60% 30% / 70% 30% 50% 60%; }
}

.orbit-ring {
  position: absolute;
  border: 1px dashed rgba(16, 185, 129, 0.3);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation: orbit-spin 20s linear infinite;
}

.ring-1 { width: 380px; height: 380px; }
.ring-2 { width: 460px; height: 460px; animation-direction: reverse; animation-duration: 30s; }

.orbit-dot {
  position: absolute;
  width: 10px;
  height: 10px;
  background: var(--primary);
  border-radius: 50%;
  top: -5px;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 0 15px var(--primary);
}

@keyframes orbit-spin {
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

.hero-img {
  position: relative;
  z-index: 2;
  max-width: 450px;
  height: auto;
  filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3));
  animation: hero-float 6s ease-in-out infinite;
}

@keyframes hero-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

/* Floating Cards */
.floating-card {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.875rem 1rem;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-radius: 12px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
  z-index: 10;
  animation: float-card 6s ease-in-out infinite;
}

.floating-card .card-icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary) 0%, #3B82F6 100%);
  border-radius: 10px;
  flex-shrink: 0;
}

.floating-card .card-icon i {
  font-size: 1.125rem;
  color: white;
}

.floating-card .card-info {
  display: flex;
  flex-direction: column;
}

.floating-card .card-label {
  font-size: 0.65rem;
  color: var(--text-muted);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.floating-card .card-value {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--text-dark);
}

.card-1 { top: 15%; left: -5%; animation-delay: 0s; }
.card-2 { bottom: 25%; left: -8%; animation-delay: 2s; }
.card-3 { top: 20%; right: -5%; animation-delay: 4s; }

@keyframes float-card {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* Tech Orbit Icons */
.tech-orbit {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
}

.tech-icon {
  position: absolute;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  animation: tech-float 4s ease-in-out infinite;
}

.tech-icon i {
  font-size: 1rem;
  color: var(--primary);
}

.tech-1 { top: 5%; left: 30%; }
.tech-2 { top: 45%; right: 5%; animation-delay: 1s; }
.tech-3 { bottom: 15%; right: 25%; animation-delay: 2s; }
.tech-4 { bottom: 35%; left: 10%; animation-delay: 3s; }

@keyframes tech-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

/* Scroll Indicator */
.scroll-indicator {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 10;
}

.scroll-indicator a {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  color: var(--text-muted-light);
  font-size: 0.75rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.mouse {
  width: 24px;
  height: 38px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 12px;
  position: relative;
}

.mouse::before {
  content: '';
  position: absolute;
  width: 4px;
  height: 8px;
  background: var(--primary);
  border-radius: 2px;
  left: 50%;
  top: 6px;
  transform: translateX(-50%);
  animation: scroll-anim 2s ease-in-out infinite;
}

@keyframes scroll-anim {
  0%, 100% { opacity: 1; top: 6px; }
  50% { opacity: 0.5; top: 16px; }
}

/* =====================================================
   STATS SECTION
   ===================================================== */
.stats-section {
  padding: 5rem 0;
  background: var(--bg-light);
  position: relative;
  z-index: 5;
}

.stats-wrapper {
  background: white;
  border-radius: 24px;
  padding: 2.5rem;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
}

.stat-card {
  text-align: center;
  padding: 1.5rem;
  position: relative;
}

.stat-glow {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100px;
  height: 100px;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.stat-icon {
  width: 60px;
  height: 60px;
  margin: 0 auto 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%);
  border-radius: 16px;
}

.stat-icon i {
  font-size: 1.5rem;
  color: var(--primary);
}

.stat-number {
  font-size: 2.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, var(--primary) 0%, #3B82F6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.25rem;
}

.stat-label {
  font-size: 0.875rem;
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.stat-bar {
  height: 4px;
  background: var(--bg-light-secondary);
  border-radius: 2px;
  overflow: hidden;
  margin-top: 1rem;
}

.stat-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, #3B82F6 100%);
  border-radius: 2px;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 1s ease-out;
}

/* =====================================================
   SKILLS SECTION
   ===================================================== */
.skills-section {
  padding: 5rem 0;
  background: var(--bg-light-secondary);
}

.section-header { margin-bottom: 3rem; }

.section-tag {
  display: inline-block;
  padding: 0.375rem 1rem;
  background: rgba(16, 185, 129, 0.1);
  border-radius: 50px;
  color: var(--primary);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 1rem;
}

.section-title {
  font-size: clamp(2rem, 4vw, 2.75rem);
  font-weight: 800;
  color: var(--text-dark);
  margin-bottom: 0.75rem;
}

.section-subtitle {
  font-size: 1.0625rem;
  color: var(--text-muted);
  max-width: 600px;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.skill-category {
  background: white;
  padding: 2rem;
  border-radius: 20px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  transition: 0.3s ease;
}

.skill-category:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
}

.category-title {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 1.25rem;
}

.category-title i {
  font-size: 1.5rem;
  color: var(--primary);
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.skill-tag {
  padding: 0.5rem 1rem;
  background: var(--bg-light-secondary);
  border-radius: 50px;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-muted);
  transition: 0.3s ease;
}

.skill-tag:hover {
  background: var(--primary);
  color: white;
  transform: translateY(-2px);
}

/* =====================================================
   PROJECTS SECTION
   ===================================================== */
.projects-section {
  padding: 5rem 0;
  background: var(--bg-dark);
}

.projects-section .section-title,
.projects-section .section-subtitle { color: white; }
.projects-section .section-subtitle { opacity: 0.7; }

.see-more-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--primary-light);
  font-weight: 600;
  transition: 0.3s ease;
}

.see-more-link:hover {
  color: white;
  gap: 0.75rem;
}

.project-card {
  background: linear-gradient(145deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  overflow: hidden;
  transition: 0.3s ease;
  height: 100%;
}

.project-card:hover {
  transform: translateY(-8px);
  border-color: rgba(16, 185, 129, 0.3);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

.project-number {
  position: absolute;
  top: 1rem;
  left: 1rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.3);
  z-index: 5;
}

.project-image {
  position: relative;
  height: 220px;
  background: linear-gradient(135deg, var(--bg-dark-secondary) 0%, var(--bg-dark) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 1rem;
}

/* Project Mockups */
.project-mockup {
  width: 100%;
  height: 100%;
  background: #1a1a2e;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.browser-bar {
  background: linear-gradient(90deg, #2d2d44 0%, #1f1f33 100%);
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.browser-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.browser-dot.red { background: #ff5f57; }
.browser-dot.yellow { background: #ffbd2e; }
.browser-dot.green { background: #28c840; }

.browser-url {
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  padding: 4px 12px;
  border-radius: 4px;
  font-size: 0.65rem;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 8px;
}

.mockup-content {
  flex: 1;
  padding: 0.75rem;
  background: #0d0d15;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.mockup-content.dark { background: #0a0a12; }

.mockup-header {
  height: 8px;
  width: 40%;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 4px;
}

.mockup-nav {
  display: flex;
  gap: 0.5rem;
}

.mockup-nav::before,
.mockup-nav::after {
  content: '';
  height: 6px;
  width: 30px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 3px;
}

.mockup-hero {
  background: linear-gradient(135deg, var(--primary) 0%, #059669 100%);
  height: 50px;
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.25rem;
}

.mockup-text {
  height: 6px;
  width: 70%;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 3px;
}

.mockup-text.short { width: 40%; }

.mockup-btn {
  height: 10px;
  width: 50px;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 5px;
}

.mockup-cards {
  display: flex;
  gap: 0.35rem;
  margin-top: auto;
}

.mockup-cards .mockup-card {
  flex: 1;
  height: 35px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 4px;
}

/* Mobile Mockup */
.project-mockup.mobile {
  max-width: 140px;
  margin: 0 auto;
  background: linear-gradient(145deg, #2d2d44 0%, #1a1a2e 100%);
  border-radius: 20px;
  padding: 8px;
  height: auto;
}

.phone-frame {
  background: #0d0d15;
  border-radius: 14px;
  overflow: hidden;
}

.phone-notch {
  width: 50px;
  height: 14px;
  background: #0d0d15;
  border-radius: 0 0 10px 10px;
  margin: 0 auto;
}

.phone-screen {
  padding: 0.5rem;
  min-height: 160px;
  background: #0d0d15;
}

.app-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.app-icon {
  width: 20px;
  height: 20px;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
  border-radius: 5px;
}

.app-icon.pulse { animation: iconPulse 2s ease-in-out infinite; }

@keyframes iconPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.app-title {
  flex: 1;
  height: 6px;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 3px;
}

.app-content {
  padding: 0.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.sos-button {
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, #ff4757 0%, #c0392b 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1rem;
  box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);
}

.app-text {
  height: 5px;
  width: 80%;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 3px;
}

.contact-cards {
  display: flex;
  gap: 0.25rem;
  width: 100%;
}

.contact-card {
  flex: 1;
  height: 25px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 4px;
}

/* Task Mockup */
.task-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem;
}

.task-avatar {
  width: 20px;
  height: 20px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
}

.task-greeting {
  flex: 1;
  height: 6px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 3px;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 0 0.5rem;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.35rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 4px;
  font-size: 0.65rem;
  color: rgba(255, 255, 255, 0.4);
}

.task-item i { font-size: 0.7rem; }

.task-item.done {
  background: rgba(16, 185, 129, 0.1);
}

.task-item.done i { color: var(--primary); }

.task-item::after {
  content: '';
  flex: 1;
  height: 5px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3px;
}

.task-progress {
  height: 3px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
  margin: 0.5rem;
  overflow: hidden;
}

.task-progress .progress-fill {
  height: 100%;
  width: 50%;
  background: linear-gradient(90deg, var(--primary) 0%, #3B82F6 100%);
  border-radius: 2px;
}

/* Project Overlay */
.project-overlay {
  position: absolute;
  inset: 0;
  background: rgba(16, 185, 129, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  opacity: 0;
  transition: 0.3s ease;
}

.project-card:hover .project-overlay { opacity: 1; }

.project-link {
  width: 50px;
  height: 50px;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  color: var(--primary);
  transform: scale(0.8);
  transition: 0.3s ease;
}

.project-link.secondary {
  background: rgba(255, 255, 255, 0.2);
  color: white;
}

.project-card:hover .project-link { transform: scale(1); }

.project-link:hover {
  background: var(--text-dark);
  color: white;
}

.project-content { padding: 1.5rem; }

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.project-tag {
  padding: 0.25rem 0.75rem;
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.2);
  border-radius: 50px;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--primary-light);
}

.project-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: white;
  margin-bottom: 0.75rem;
}

.project-description {
  font-size: 0.9rem;
  color: var(--text-muted-light);
  line-height: 1.6;
  margin-bottom: 1rem;
}

.project-more {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--primary-light);
  font-weight: 600;
  font-size: 0.9rem;
  transition: 0.3s ease;
}

.project-more:hover {
  color: white;
  gap: 0.75rem;
}

/* =====================================================
   EXPERIENCE SECTION
   ===================================================== */
.experience-section {
  padding: 5rem 0;
  background: var(--bg-light);
}

.experience-timeline {
  position: relative;
  max-width: 900px;
  margin: 0 auto;
  padding-top: 2rem;
}

.timeline-line {
  position: absolute;
  left: 28px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: linear-gradient(180deg, var(--primary) 0%, #3B82F6 100%);
}

.experience-item {
  position: relative;
  padding-left: 70px;
  margin-bottom: 2rem;
}

.timeline-dot {
  position: absolute;
  left: 20px;
  top: 0;
  width: 18px;
  height: 18px;
  background: var(--primary);
  border-radius: 50%;
  box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.2);
}

.timeline-icon {
  position: absolute;
  left: 0;
  top: -5px;
  font-size: 1.5rem;
  color: var(--text-muted);
}

.experience-card {
  background: linear-gradient(145deg, #1E4D3D 0%, #0F3027 100%);
  border-radius: 20px;
  padding: 2rem;
  color: white;
  position: relative;
  overflow: hidden;
}

.experience-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 150px;
  height: 150px;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.2) 0%, transparent 70%);
}

.card-header { text-align: center; margin-bottom: 1.5rem; }

.company-name {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 0.25rem;
}

.job-title {
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 0.5rem;
}

.job-period {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.6);
}

.job-description {
  font-size: 0.95rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 1rem;
}

.experience-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.experience-tag {
  padding: 0.375rem 0.875rem;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50px;
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.9);
}

.experience-more {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--primary);
  font-weight: 600;
  margin-top: 2rem;
}

.experience-more:hover { gap: 0.75rem; }

/* =====================================================
   CTA SECTION
   ===================================================== */
.cta-section {
  padding: 5rem 0;
  background: var(--bg-light);
  text-align: center;
}

.cta-title {
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 1rem;
}

.cta-description {
  font-size: 1.0625rem;
  color: var(--text-muted);
  max-width: 600px;
  margin: 0 auto 2rem;
}

.cta-buttons {
  display: flex;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}

/* =====================================================
   FOOTER
   ===================================================== */
.footer {
  background: var(--bg-dark);
  color: white;
  padding: 4rem 0 2rem;
}

.footer-brand .brand-text {
  font-size: 1.5rem;
  font-weight: 800;
  color: white;
  margin-bottom: 1rem;
}

.footer-description {
  color: var(--text-muted-light);
  max-width: 300px;
  margin-bottom: 1.5rem;
}

.footer-social {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.footer-social a {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  color: white;
  transition: 0.3s ease;
}

.footer-social a:hover {
  background: var(--primary);
  transform: translateY(-3px);
}

.footer-title {
  font-size: 1rem;
  font-weight: 700;
  color: white;
  margin-bottom: 1.5rem;
}

.footer-links { list-style: none; }

.footer-links li {
  margin-bottom: 0.75rem;
}

.footer-links a {
  color: var(--text-muted-light);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.footer-links a:hover { color: var(--primary); }

.footer-bottom {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  text-align: center;
}

.copyright {
  color: var(--text-muted-light);
  font-size: 0.875rem;
  margin-bottom: 0.5rem;
}

.made-with {
  color: var(--text-muted-light);
  font-size: 0.8rem;
}

.made-with i { color: #ff6b6b; }

/* Back to Top */
.back-to-top {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  width: 45px;
  height: 45px;
  background: var(--primary);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  opacity: 0;
  visibility: hidden;
  transition: 0.3s ease;
  z-index: 999;
  cursor: pointer;
}

.back-to-top.visible {
  opacity: 1;
  visibility: visible;
}

.back-to-top:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(16, 185, 129, 0.3);
}

/* =====================================================
   RESPONSIVE
   ===================================================== */
@media (max-width: 991.98px) {
  .floating-card { display: none; }
  .tech-orbit { display: none; }
  .orbit-ring { display: none; }
  
  .hero-image-wrapper { min-height: auto; margin-top: 3rem; }
  .hero-img { max-width: 350px; }
}

@media (max-width: 767.98px) {
  .hero-section { padding-top: 70px; }
  .hero-cta { flex-direction: column; }
  .hero-cta .btn { width: 100%; justify-content: center; }
  .scroll-indicator { display: none; }
  
  .stats-wrapper { padding: 1.5rem; }
  .stat-number { font-size: 2rem; }
  
  .experience-item { padding-left: 50px; }
  .timeline-icon { display: none; }
  .timeline-line { left: 18px; }
  .timeline-dot { left: 10px; }
}

@media (max-width: 575.98px) {
  .navbar-brand .brand-text { font-size: 1.25rem; }
  .hero-title { font-size: 2rem; }
  .hero-subtitle { font-size: 1.125rem; }
  .section-title { font-size: 1.75rem; }
  
  .cta-buttons { flex-direction: column; }
  .cta-buttons .btn { width: 100%; }
}
